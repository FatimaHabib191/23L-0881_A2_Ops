# Copy to .env and fill in. .env is git-ignored and docker-ignored.

# MLflow on DagsHub (leave the URI blank to log to a local SQLite database)
MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_DAGSHUB_USER/23L-0881_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=YOUR_DAGSHUB_USER
MLFLOW_TRACKING_PASSWORD=YOUR_DAGSHUB_TOKEN

# Database. Use letters and digits in the password, because it is placed in a URL.
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=visionguard

# Flask
SECRET_KEY=change_me_to_a_long_random_value
MAX_UPLOAD_MB=8

# Model. MODEL_THRESHOLD comes from val_result.json of the champion run.
MODEL_VERSION=VisionGuard:v2
MODEL_THRESHOLD=0.5

# Inference: "local" loads ./models/champion/model.keras, "remote" calls the cloud API.
INFERENCE_MODE=local
MODEL_API_URL=http://YOUR_VM_PUBLIC_IP:8000
MODEL_API_KEY=change_me_to_a_long_random_value
